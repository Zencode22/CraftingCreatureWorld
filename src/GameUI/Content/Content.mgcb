# MonoGame Content Builder (MGCB) file for Creature Craft.
# Fonts are rasterised from the bundled DejaVu TTFs (free, redistributable).

#begin Fonts/UI.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Fonts/UI.spritefont;Fonts/UI

#end

#begin Fonts/UIBold.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Fonts/UIBold.spritefont;Fonts/UIBold

#end
